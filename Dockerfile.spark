FROM apache/spark:3.5.3

ARG KAFKA_CONNECTOR_VERSION=3.5.3
ARG KAFKA_CLIENTS_VERSION=3.6.1
ARG COMMONS_POOL_VERSION=2.11.1

USER root

RUN pip install --no-cache-dir "psycopg[binary]>=3.2,<4.0"

RUN set -eux; \
    curl -fsSL --retry 3 \
      -o /opt/spark/jars/spark-sql-kafka-0-10_2.12-${KAFKA_CONNECTOR_VERSION}.jar \
      https://repo1.maven.org/maven2/org/apache/spark/spark-sql-kafka-0-10_2.12/${KAFKA_CONNECTOR_VERSION}/spark-sql-kafka-0-10_2.12-${KAFKA_CONNECTOR_VERSION}.jar; \
    curl -fsSL --retry 3 \
      -o /opt/spark/jars/spark-token-provider-kafka-0-10_2.12-${KAFKA_CONNECTOR_VERSION}.jar \
      https://repo1.maven.org/maven2/org/apache/spark/spark-token-provider-kafka-0-10_2.12/${KAFKA_CONNECTOR_VERSION}/spark-token-provider-kafka-0-10_2.12-${KAFKA_CONNECTOR_VERSION}.jar; \
    curl -fsSL --retry 3 \
      -o /opt/spark/jars/kafka-clients-${KAFKA_CLIENTS_VERSION}.jar \
      https://repo1.maven.org/maven2/org/apache/kafka/kafka-clients/${KAFKA_CLIENTS_VERSION}/kafka-clients-${KAFKA_CLIENTS_VERSION}.jar; \
    curl -fsSL --retry 3 \
      -o /opt/spark/jars/commons-pool2-${COMMONS_POOL_VERSION}.jar \
      https://repo1.maven.org/maven2/org/apache/commons/commons-pool2/${COMMONS_POOL_VERSION}/commons-pool2-${COMMONS_POOL_VERSION}.jar; \
    chown spark:spark /opt/spark/jars/*kafka*.jar /opt/spark/jars/commons-pool2-*.jar

ENV PYSPARK_PYTHON=/usr/bin/python3 \
    PYSPARK_DRIVER_PYTHON=/usr/bin/python3

USER spark
